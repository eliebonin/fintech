{
  "name": "platform-workspace",
  "private": true,
  "packageManager": "pnpm@10.7.1",
  "pnpm": {
    "overrides": {
      "@redocly/openapi-core": "1.34.19"
    }
  },
  "scripts": {
    "contract:export": ".\\.venv\\Scripts\\python.exe scripts/export_openapi_contract.py",
    "contract:check": ".\\.venv\\Scripts\\python.exe scripts/export_openapi_contract.py --check",
    "contract:generate": "pnpm --filter api-contracts generate",
    "contract:generate:check": "pnpm --filter api-contracts generate:check",
    "workspace:list": "pnpm -r list --depth -1",
    "dev:reference-api": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.reference_api.main:app --host 127.0.0.1 --port 8000 --reload",
    "start:reference-api": ".\\.venv\\Scripts\\python.exe -m uvicorn apps.reference_api.main:app --host 127.0.0.1 --port 8000",
    "dev:ops-console": "pnpm --filter ops-console dev",
    "build:ops-console": "pnpm --filter ops-console build",
    "test:ops-console": "pnpm --filter ops-console test",
    "typecheck:ops-console": "pnpm --filter ops-console typecheck"
  }
}
