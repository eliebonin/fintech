DATABASE_URL=postgresql+psycopg://platform_runtime:<private-runtime-password>@127.0.0.1:54329/platform_secm
REFERENCE_API_URL=http://localhost:8000
APP_ENV=local
# Run .venv/Scripts/python.exe scripts/configure_local_access.py once. It writes
# matching private values to ignored .env.local-access and the frontend .env.local.
# The API launcher loads .env.local-access. Never use a NEXT_PUBLIC_ key.
LOCAL_ACCESS_OPERATOR_KEY=
LOCAL_PLATFORM_OPERATOR_ID=00000000-0000-7000-8000-000000000304
ALLOW_SYNTHETIC_FALLBACK=true
DEMO_TENANT_ID=00000000-0000-7000-8000-000000000011

# Frontend upstream reads: positive integer milliseconds (default 10000).
REFERENCE_API_READ_TIMEOUT_MS=10000

# Expensive-operation admission. Configure all API workers consistently.
# Limits concurrent work, never the trade/instrument population in a calculation.
REFERENCE_API_WORKLOAD_PROCESS_LIMIT=2
REFERENCE_API_WORKLOAD_GLOBAL_LIMIT=2
REFERENCE_API_WORKLOAD_TENANT_LIMIT=1
REFERENCE_API_WORKLOAD_RETRY_AFTER=5

# Optional: existing local installation names. Export DATABASE_URL to Python
# processes; Docker Compose reads its own .env, Python entry points do not.
LOCAL_WORKSPACE_DATABASE=platform_secm
POSTGRES_CONTAINER_NAME=platform-postgres
POSTGRES_VOLUME_NAME=platform_security_master_postgres
POSTGRES_DB=platform_secm
POSTGRES_USER=platform
# Docker uses .local-secrets/postgres-admin-password, generated by
# scripts/configure_local_database.py --prepare. No password fallback.
# Migrations use ignored .env.migrations, not the API's DATABASE_URL.
# Optional isolated-test connection (database is replaced with an owned name).
TEST_DATABASE_ADMIN_URL=postgresql+psycopg://platform:<local-password>@127.0.0.1:54329/postgres
